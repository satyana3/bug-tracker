pipeline {
    agent any

    stages {

        stage('Unit Tests - Backend') {
            steps {
                // Wrapped the test and reporting commands in 'sh -c' so go-junit-report runs inside the container
                bat 'docker run --rm -v "%CD%\\bugtracker-backend:/app" -w /app snakee/golang-junit:1.21 sh -c "go test -v ./... 2>&1 | go-junit-report > test-results.xml"'
            }
        }

        stage('Unit Tests - Frontend') {
            steps {
                bat 'docker run --rm -v "%CD%\\bugtracker-frontend:/app" -w /app node:20-alpine sh -c "npm ci && npm test"'
            }
        }

    }

    post {
        always {
            junit 'bugtracker-backend/test-results.xml'
            junit 'bugtracker-frontend/test-results.xml'
        }
    }
}
